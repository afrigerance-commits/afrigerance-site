# Copier ce fichier sous le nom .env.local (jamais envoyé sur GitHub) puis renseigner les valeurs.
# Toutes ces variables sont lues uniquement par le serveur : elles ne partent jamais vers le navigateur.
# Sur l'hébergeur, définir les mêmes variables dans ses réglages « Environment Variables ».

# ── Base de données (obligatoire pour recevoir les demandes) ─────────────────
# Adresse de connexion PostgreSQL, fournie par l'hébergeur de la base (ex. Neon : bouton « Connect »).
# Exemple de forme : postgresql://utilisateur:motdepasse@hote/neondb?sslmode=require
# SECRÈTE : elle contient le mot de passe de la base.
# Sans elle, les formulaires affichent « Rien n'a été envoyé » (aucune demande n'est perdue ni simulée).
DATABASE_URL=

# ── Email de notification au gestionnaire (facultatif mais recommandé) ───────
# Sans ces trois valeurs, les demandes sont quand même enregistrées : l'administration
# les signale alors comme « notification non envoyée ».

# Clé API Resend (https://resend.com → API Keys). SECRÈTE.
RESEND_API_KEY=

# Expéditeur. Sans domaine vérifié chez Resend : AFRIGERANCE <onboarding@resend.dev>
# (cette adresse de test n'écrit qu'à l'adresse email du compte Resend).
NOTIFICATION_EMAIL_FROM=

# Adresse(s) du gestionnaire qui reçoit les notifications, séparées par des virgules.
NOTIFICATION_EMAIL_TO=

# ── Adresse publique du site (facultatif) ────────────────────────────────────
# Permet d'ajouter dans l'email un lien direct vers la demande, ex. https://www.votre-domaine.sn
SITE_URL=
