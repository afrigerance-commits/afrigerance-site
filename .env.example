# Copier ce fichier sous le nom .env.local (jamais commité) puis renseigner les valeurs.
# Ces variables sont lues uniquement par le serveur : elles ne sont jamais envoyées au navigateur.
# Tant qu'elles sont vides, les formulaires affichent « Rien n'a été envoyé » (aucune réussite simulée).

# Clé API Resend (https://resend.com → API Keys). SECRÈTE : ne jamais la publier.
RESEND_API_KEY=

# Expéditeur des emails de notification.
# Sans domaine vérifié chez Resend, utiliser l'adresse de test : AFRIGERANCE <onboarding@resend.dev>
# (elle ne peut écrire qu'à l'adresse email du compte Resend).
NOTIFICATION_EMAIL_FROM=

# Adresse(s) qui reçoivent les demandes de devis et de contact, séparées par des virgules.
NOTIFICATION_EMAIL_TO=
