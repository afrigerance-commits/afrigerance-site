# Copiez ce fichier vers .env.local et renseignez vos propres valeurs.
# Ne committez jamais .env.local (déjà ignoré par .gitignore).

# --- Supabase ------------------------------------------------------------
# Tant que ces variables ne sont pas définies, le site public fonctionne
# avec les données de démonstration locales (src/lib/data/*.ts), mais
# l'authentification et l'administration (/admin, /compte) restent inactives.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé de service : UNIQUEMENT côté serveur (jamais exposée au navigateur,
# jamais préfixée NEXT_PUBLIC_). Utilisée par les scripts d'administration
# avancée uniquement si nécessaire.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=
